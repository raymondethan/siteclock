{
  "manifest_version": 3,
  "name": "SiteClock",
  "version": "0.4.0",
  "description": "See daily, last 7 days, and lifetime website usage. Optional cloud backup syncs your totals across computers.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "tabs",
    "idle",
    "alarms",
    "identity"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SiteClock",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "incognito": "not_allowed",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "https://6d5c5o3m30.execute-api.us-east-2.amazonaws.com/*",
    "https://siteclock-prod-513420.auth.us-east-2.amazoncognito.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://6d5c5o3m30.execute-api.us-east-2.amazonaws.com https://siteclock-prod-513420.auth.us-east-2.amazoncognito.com;"
  }
}
